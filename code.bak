// h, m, s
const initial = [0, 0, 0];
const current = [0, 0, 0];
const timeMultiplier = 500;

function setup() {
  createCanvas(400, 400);

  initial[0] = hour();
  initial[1] = minute();
  initial[2] = second();

  textAlign(CENTER, CENTER);
}

function draw() {
  background(220);

  current[2] = (initial[2] + timeMultiplier * millis() / 1000) % 60;
  current[1] = (initial[1] + timeMultiplier * millis() / (1000 * 60)) % 60;
  current[0] = (initial[0] + timeMultiplier * millis() / (1000 * 60 * 60)) % 24;
  
  console.log(`${current[0]}:${current[1]}:${current[2]}`)
  
  const center = [width / 2, height];

  drawWatch(center[0], center[1], -sAngle(current[2]), 50);
  drawWatch(center[0], center[1], -mAngle(current[1]), 100);
  drawWatch(center[0], center[1], -hAngle(current[0]), 150);
}

function drawWatch(x, y, angle, rad) {
  push();
  translate(x, y);
  rotate(radians(angle));
  for (let n = 0; n < 12; n++) {
    push();
    const angle = (n * 360) / 12;
    rotate(radians(angle));
    const timeText = n == 0 ? 12 : n;
    text(timeText, 0, -rad);
    pop();
  }
  pop();
}

function hAngle(time) {
  return map(time % 12, 0, 12, 0, 360);
}
function mAngle(time) {
  return map(time, 0, 60, 0, 360);
}
function sAngle(time) {
  return map(time, 0, 60, 0, 360);
}
